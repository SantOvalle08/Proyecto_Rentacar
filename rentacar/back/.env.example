# ─── RentaCar Backend — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.

# ── Database ───────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (include the database name in the path).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rentacar?retryWrites=true&w=majority&appName=rentacar

# ── Auth ───────────────────────────────────────────────────────────────────────
# Must be a long, random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-secure-random-value

# ── CORS ───────────────────────────────────────────────────────────────────────
# Public URL of the deployed frontend (no trailing slash).
# In App Runner, set this to the frontend service URL.
# If not set, only localhost origins are allowed.
FRONTEND_URL=https://win4nmi2ap.us-east-2.awsapprunner.com

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
