# Variables de Entorno para Producción en GCP

# IMPORTANTE: NO subir este archivo a Git
# Agrega .env a .gitignore

# MongoDB Atlas Connection String
# Obtén esto desde MongoDB Atlas → Connect → Drivers
# IMPORTANTE: incluye el nombre de la base de datos en la ruta, por ejemplo /rentacar
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/rentacar?retryWrites=true&w=majority&appName=rentacar

# Puerto (GCP lo asigna automáticamente)
PORT=8080

# Entorno
NODE_ENV=production

# JWT Secret (cambia esto por algo seguro)
JWT_SECRET=tu-secreto-jwt-muy-seguro-y-aleatorio-12345

# CORS Origins (opcional - el backend ya permite todos)
# CORS_ORIGIN=https://tu-frontend.vercel.app
